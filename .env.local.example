# Supabase のダッシュボード → Project Settings → API Keys からコピーする
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Cloudflare Turnstile（ログイン・新規登録・パスワードの再設定のロボットよけ）
# Cloudflare のダッシュボード → Turnstile → サイトを追加 で出るキー。
# 入れないときは、開発中（npm run dev）は試し用のキー（いつも通る）で動き、公開したもの（npm run build）では出ない
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# シークレットキーはローカル版の確かめだけで使う。Supabase 版では Supabase の設定の画面に入れる（ここには要らない）
TURNSTILE_SECRET_KEY=

# 公開したもの（npm run build）は、Supabase の URL とキーが無いと「まだ使える状態ではありません」の画面だけを出す。
# 試しにローカル版（データはそれぞれのブラウザの中だけ）のまま公開するときだけ 1 にする
NEXT_PUBLIC_ALLOW_LOCAL_MODE=

# 利用規約・プライバシーポリシー・お問い合わせのページに出す、お問い合わせのメールアドレス（運営者の名前は src/lib/site.ts）
NEXT_PUBLIC_CONTACT_EMAIL=
